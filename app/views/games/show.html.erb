<div class="w-full max-w-xl mx-auto flex flex-col gap-6">
  <div class="text-center">
    <h1 class="text-2xl font-bold"><%= @game.player_name %></h1>
    <p class="text-sm text-gray-500">Jogo #<%= @game.id %></p>
  </div>

  <%= turbo_frame_tag "score" do %>
    <%= render "score", game: @game %>
  <% end %>

  <%= turbo_frame_tag "round" do %>
    <%= render "round", game: @game, round: @round, last_round: nil %>
  <% end %>
</div>
