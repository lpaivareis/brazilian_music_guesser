<div class="w-full max-w-lg mx-auto flex flex-col gap-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Ranking</h1>
    <%= link_to "Novo jogo", root_path, class: "text-indigo-600 hover:underline font-medium" %>
  </div>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="w-full text-left">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="px-4 py-2 text-sm font-semibold text-gray-600">#</th>
          <th class="px-4 py-2 text-sm font-semibold text-gray-600">Jogador</th>
          <th class="px-4 py-2 text-sm font-semibold text-gray-600 text-right">Pontuação</th>
        </tr>
      </thead>
      <tbody>
        <% @top_games.each_with_index do |game, index| %>
          <tr class="border-b border-gray-100 last:border-b-0">
            <td class="px-4 py-2 text-gray-500"><%= index + 1 %></td>
            <td class="px-4 py-2 font-medium"><%= game.player_name %></td>
            <td class="px-4 py-2 text-right"><%= game.score %></td>
          </tr>
        <% end %>
        <% if @top_games.empty? %>
          <tr>
            <td colspan="3" class="px-4 py-6 text-center text-gray-400">Nenhum jogo finalizado ainda.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
